{
  "name": "talk-me-chat",
  "version": "1.0.0",
  "description": "Chat Talk.Me para red local",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "setup": "node setup-model.js",
    "rebuild-native": "node-gyp rebuild",
    "rebuild-electron": "electron-rebuild -f -t %ELECTRON_VERSION%",
    "build:win": "set ASIO_SDK_PATH=C:\\Dev\\ASIO_SDK && npm run rebuild-native"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "e131": "^1.1.3",
    "ejs": "^5.0.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^18.2.1",
    "linear-timecode": "*",
    "multer": "^2.1.1",
    "osc": "*",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.2.1",
    "socket.io": "^4.7.2",
    "socket.io-redis": "^6.1.1"
  },
  "extras": {
    "note": "The dependencies for ASIO/SoundGrid are placeholders; native bindings must be compiled or provided by vendor SDKs. See 00 DOCS for details."
  },
  "optionalDependencies": {
    "vosk": "^0.3.39"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-rebuild": "^2.0.3",
    "node-addon-api": "^5.0.0",
    "node-gyp": "^12.3.0"
  }
}
