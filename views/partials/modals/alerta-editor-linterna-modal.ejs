<!-- Modal Editor de Alerta Linterna (estilo profesional - Paridad Total con Triggers) -->
<div class="user-modal hidden" id="alertEditorLinternaModal">
    <div class="modal-content triggers-content" id="linternaEditorUI">
        <div class="triggers-scroll-wrapper custom-scroll">
            <h2 class="modal-title-small" id="lblEditorTitleLinterna">Editor de Alerta Linterna</h2>
            <p class="modal-subtitle" id="lblEditorDescLinterna">Configura destellos LED. Nota: Por seguridad, se
                limitará la frecuencia de parpadeo.</p>
            <button class="modal-close-icon" id="btnCloseAlertEditorLinterna" title="Cerrar">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                    stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>

            <div class="timeline-header">
                <div>
                    <h3 id="lblTimelineEasingLinterna">Timeline y Easing</h3>
                    <p id="lblTimelineHintLinterna">Haz doble clic en el lienzo para ubicar nuevos keyframes.</p>
                    <button id="btnRestoreLinterna" class="btn-restore"
                        style="margin-top: 8px; padding: 6px 14px; font-size: 11px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                            <path d="M3 3v5h5"></path>
                        </svg>
                        <span id="lblRestoreAnimLinterna">Restaurar Animación Original</span>
                    </button>
                </div>

                <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="global-duration duration-widget-pro">
                        <div class="duration-control-pro">
                            <button id="btnLinternaDurDown" class="prop-stepper-btn duration-btn-pro" title="Disminuir duración">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                            </button>
                            <div class="duration-input-wrapper-pro">
                                <input type="text" id="linternaDuracion" value="3.0" class="duration-input-pro">
                                <span class="duration-unit-pro">s</span>
                            </div>
                            <button id="btnLinternaDurUp" class="prop-stepper-btn duration-btn-pro" title="Aumentar duración">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="timeline-controls">
                        <!-- Punto animado (luz) -->
                        <div class="animation-point">
                            <div class="point-indicator"></div>
                        </div>

                        <button id="btnPlayLinterna" class="timeline-btn" title="Reproducir">
                            <svg viewBox="0 0 24 24" width="20" height="20">
                                <path d="M8 5v14l11-7z" fill="white" />
                            </svg>
                        </button>
                        <button id="btnStopLinterna" class="timeline-btn" title="Detener">
                            <svg viewBox="0 0 24 24" width="20" height="20">
                                <rect x="6" y="6" width="12" height="12" fill="white" />
                            </svg>
                        </button>
                        <button id="btnLoopLinterna" class="timeline-btn loop" title="Bucle">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="white"
                                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="23 4 23 10 17 10"></polyline>
                                <polyline points="1 20 1 14 7 14"></polyline>
                                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15">
                                </path>
                            </svg>
                        </button>
                        <button id="btnLiveLinterna" class="timeline-btn live" title="Prueba Real">
                            <svg viewBox="0 0 24 24" width="20" height="20">
                                <circle cx="12" cy="12" r="10" stroke="white" stroke-width="1.5" fill="none" />
                                <circle cx="12" cy="12" r="4" fill="white" />
                            </svg>
                        </button>
                    </div>

                    <!-- Botón añadir movido a la línea 1 para paridad total -->
                    <button id="btnAddLinternaKf" class="btn-add">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span id="lblAddKeyframeLinterna">Keyframe</span>
                    </button>
                </div>
            </div>


            <div class="canvas-wrapper">
                <canvas id="linternaCanvas" width="800" height="200"></canvas>
                <div class="timeline-cursor"></div>
            </div>

            <!-- Propiedades Keyframe unificadas -->
            <div id="linternaKfProps" class="keyframe-properties" style="display:none;">
                <div class="prop-group" style="flex:0.8;">
                    <label>Etiqueta</label>
                    <input type="text" id="linternaKfName">
                </div>
                <div class="prop-group" style="flex:0.8;">
                    <label>Tiempo (ms)</label>
                    <div class="prop-stepper">
                        <input type="text" id="linternaKfTime">
                        <div class="prop-stepper-buttons">
                            <button class="linterna-kf-stepper prop-stepper-btn" data-field="time" data-delta="100">
                                <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="18 15 12 9 6 15"></polyline>
                                </svg>
                            </button>
                            <button class="linterna-kf-stepper prop-stepper-btn" data-field="time" data-delta="-100">
                                <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="prop-group" style="flex:0.8;">
                    <label>Estado (0-1)</label>
                    <div class="prop-stepper">
                        <input type="text" id="linternaKfValue">
                        <div class="prop-stepper-buttons">
                            <button class="linterna-kf-stepper prop-stepper-btn" data-field="value" data-delta="0.1">
                                <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="18 15 12 9 6 15"></polyline>
                                </svg>
                            </button>
                            <button class="linterna-kf-stepper prop-stepper-btn" data-field="value" data-delta="-0.1">
                                <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="prop-group" style="flex: 1;">
                    <label>Hold Time</label>
                    <div class="prop-stepper">
                        <input type="text" id="linternaKfHold">
                        <div class="prop-stepper-buttons">
                            <button class="linterna-kf-stepper prop-stepper-btn" data-field="hold" data-delta="50">
                                <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="18 15 12 9 6 15"></polyline>
                                </svg>
                            </button>
                            <button class="linterna-kf-stepper prop-stepper-btn" data-field="hold" data-delta="-50">
                                <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="prop-group"
                    style="flex: 0.2; align-items: center; justify-content: center; min-width: 40px;">
                    <label style="opacity: 0;">&nbsp;</label>
                    <button class="delete-btn delete-kf-btn" id="btnDeleteLinternaKf" title="Borrar"
                        style="background: transparent; border: none; padding: 0; opacity: 0.7; height: 34px; display: flex; align-items: center; justify-content: center; margin: 0 10px 0 5px !important; align-self: center !important; width: auto !important;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                            </path>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="keyframes-list">
                <h4 id="lblKeyframeOrderLinterna">Orden de Keyframes</h4>
                <div class="keyframes-scroll-area custom-scroll">
                    <div id="linternaKeyframes" class="keyframe-items"></div>
                </div>
            </div>

            <div class="action-buttons">
                <button id="btnSaveAlertLinterna" class="btn-save">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>
                    </svg>
                    <span>Guardar Alerta</span>
                </button>
                <button id="btnCancelAlertLinterna" class="btn-cancel">Cancelar</button>
            </div>
        </div>
    </div>
</div>