                <span id="lblNavGuia">Guía</span>
            </button>

            <button class="nav-item" data-section="section-legal">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M14.5 9.5C13.8 8.8 12.9 8.5 12 8.5C10.07 8.5 8.5 10.07 8.5 12C8.5 13.93 10.07 15.5 12 15.5C12.9 15.5 13.8 15.2 14.5 14.5" />
                </svg>
                <span id="lblNavLegal">Legal</span>
            </button>
        </div>


        <div class="settings-content-wrapper">
            <!-- Sección Idioma -->
            <div class="settings-section-content active" id="section-idioma">
                <h2 class="modal-title-small">Idioma y Voz</h2>
                <div class="setting-row">
                    <label id="lblUiLang">Idioma de Interfaz</label>
                    <div class="lang-selector-group">
                        <% (typeof installedLangs !=='undefined' ? installedLangs : ['es', 'en' , 'eu'
                            ]).forEach(function(lang) { %>
                            <button class="lang-pill <%= lang === 'es' ? 'active' : '' %>" data-lang="<%= lang %>">
                                <%= (typeof langNames !=='undefined' && langNames[lang]) ? langNames[lang] :
                                    lang.toUpperCase() %>
                            </button>
                            <% }); %>
                    </div>
                </div>
                <div class="setting-row">
                    <label id="lblVocabTitle">Transcripción IA (<span id="dictLangLabel"
                            style="color:var(--accent-orange); font-weight:700;">ES</span>)</label>
                    <p class="modal-subtitle-extra-small" id="lblVocabSubtitle">Añade palabras difíciles para
                        mejorar la precisión</p>

                    <div class="dictionary-input-group-columns-modular">
                        <div class="dict-field">
                            <input type="text" class="dict-input-mod" id="dictFrom" placeholder="Entiende..."
                                maxlength="50">
                        </div>
                        <div class="dict-field">
                            <input type="text" class="dict-input-mod" id="dictTo" placeholder="Corregir a..."
                                maxlength="50">
                        </div>
                        <button class="btn-add-tag-mod" id="btnAddWord" title="Añadir">+</button>
                    </div>

                    <div class="dictionary-tags-modular custom-scroll" id="dictionaryTags">
                        <!-- Tags aparecerán aquí -->
                    </div>
                </div>
            </div>

            <!-- Sección Alertas -->
            <div class="settings-section-content" id="section-alertas">
                <h2 class="modal-title-small" id="lblSectionAlertasTitle">Alertas</h2>
                <div class="setting-row">
                    <label id="lblPersonalizarAlertas">Personalizar alertas</label>
                    <p class="modal-subtitle-extra-small" id="lblInstruccionAlerta">Pulsa en una fila para diseñar su
                        patrón de animación/ritmo.</p>
                    <div id="alertsList" class="alerts-list">
                        <div class="compact-toggle alert-row clickable-alert-row" data-alert-type="pantalla">
                            <div class="alert-status-toggle-container" style="display: inline-flex; align-items: center;">
                                <span class="trigger-toggle tgl-off" id="btnToggleScreenAlerts" style="cursor: pointer;">OFF</span>
                                <input type="checkbox" class="alert-enable" id="screenAlertsToggle" data-alert-type="pantalla" style="display:none;">
                            </div>
                            <div class="alert-info">
                                <div>
                                    <strong id="lblScreenAlertTitle">Pantalla</strong>
                                    <div class="modal-subtitle-extra-small" id="lblScreenAlertDesc">Animación de color y
                                        opacidad</div>
                                </div>
                            </div>
                        </div>

                        <div class="compact-toggle alert-row clickable-alert-row" data-alert-type="vibracion">
                            <div class="alert-status-toggle-container" style="display: inline-flex; align-items: center;">
                                <span class="trigger-toggle tgl-off" id="btnToggleVibrationAlerts" style="cursor: pointer;">OFF</span>
                                <input type="checkbox" class="alert-enable" id="vibrationToggleAlt" data-alert-type="vibracion" style="display:none;">
                            </div>
                            <div class="alert-info">
                                <div>
                                    <strong id="lblVibrationAlertTitle">Vibración</strong>
                                    <div class="modal-subtitle-extra-small" id="lblVibrationAlertDesc">Patrón rítmico de
                                        haptics</div>
                                </div>
                            </div>
                        </div>

                        <div class="compact-toggle alert-row clickable-alert-row" data-alert-type="linterna">
                            <div class="alert-status-toggle-container" style="display: inline-flex; align-items: center;">
                                <span class="trigger-toggle tgl-off" id="btnToggleFlashlightAlerts" style="cursor: pointer;">OFF</span>
                                <input type="checkbox" class="alert-enable" id="flashlightToggleAlt" data-alert-type="linterna" style="display:none;">
                            </div>
                            <div class="alert-info">
                                <div>
                                    <strong id="lblFlashlightAlertTitle">Linterna</strong>
                                    <div class="modal-subtitle-extra-small" id="lblFlashlightAlertDesc">Secuencia de
                                        destellos LED</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Sección Audio -->
            <div class="settings-section-content" id="section-audio">
                <h2 class="modal-title-small" id="lblSectionAudioTitle">Configuración de Audio</h2>

                <div class="setting-row" id="audioOutputContainer">
                    <label id="lblAudioOutput">Salida de Audio</label>
                    <div class="talkme-select-container">
                        <select id="audioOutputSelect" class="talkme-select"></select>
                        <div class="talkme-select-arrow">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                                stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>
                    <!-- [v59.18] Selección de canal de salida granular -->
                    <div class="talkme-select-container channel-select-container" style="margin-top: 8px;">
                        <select id="audioOutputChannelSelect" class="talkme-select select-channel">
                            <option value="0">Ch 1</option>
                        </select>
                        <div class="talkme-select-arrow">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                                stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>
                </div>
                <div class="setting-row">
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label id="lblMicInput" style="margin-bottom: 0;">Entrada de Micrófono</label>
                        <button id="btnRefreshAudioHardware" class="talkme-icon-btn"
                            title="Refrescar canales y hardware"
                            style="background: none; border: none; padding: 4px; cursor: pointer; color: var(--accent-orange, #ff6b00); display: flex; align-items: center; justify-content: center; transition: transform 0.2s ease;">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="refresh-icon">
                                <polyline points="23 4 23 10 17 10"></polyline>
                                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="talkme-select-container">
                        <select id="audioDeviceSelect" class="talkme-select"></select>
                        <div class="talkme-select-arrow">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                                stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>
                    <!-- [v59.18] Selección de canal de entrada granular -->
                    <div class="talkme-select-container channel-select-container" style="margin-top: 8px;">
                        <select id="audioDeviceChannelSelect" class="talkme-select select-channel">
                            <option value="0">Ch 1</option>
                        </select>
                        <div class="talkme-select-arrow">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                                stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sección Traducción (IA) -->
            <div class="settings-section-content" id="section-traduccion">
                <h2 class="modal-title-small" id="lblSectionTraduccionTitle">Motor de Traducción IA</h2>


                <div class="translation-grid">
                    <!-- Columna 1: Traducción Automática -->
                    <div class="setting-row" style="flex: 1; margin-bottom: 0;">
                        <label id="lblTradAuto"
                            style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px;">Traducción
                            Automática</label>
                        <div style="display: flex; align-items: center; margin-top: 8px;">
                            <span class="trigger-toggle tgl-off" id="btnToggleTranslateEnable" style="cursor: pointer; margin-right: 8px !important; flex-shrink: 0;">OFF</span>
                            <input type="checkbox" class="alert-enable" id="translateEnableToggle" style="display:none;">
                            <p class="modal-subtitle-extra-small" id="lblTradAutoDesc"
                                style="margin: 0; padding-top: 2px;">Traduce el chat al idioma de tu interfaz.</p>
                        </div>
                    </div>

                    <!-- Columna 2: Mensaje Original -->
                    <div class="setting-row" id="showOriginalContainer"
                        style="flex: 1; margin-bottom: 0; transition: opacity 0.3s ease;">
                        <label id="lblTradOriginal"
                            style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px;">Mensaje
                            Original</label>
                        <div style="display: flex; align-items: center; margin-top: 8px;">
                            <span class="trigger-toggle tgl-off" id="btnToggleShowOriginal" style="cursor: pointer; margin-right: 8px !important; flex-shrink: 0;">OFF</span>
                            <input type="checkbox" class="alert-enable" id="showOriginalToggle" style="display:none;">
                            <p class="modal-subtitle-extra-small" id="lblTradOrigDesc"
                                style="margin: 0; padding-top: 2px;">Muestra el texto en su idioma nativo bajo la
                                traducción.</p>
                        </div>
                    </div>
                </div>

                <div id="translationSuboptions" class="translation-suboptions">
                    <div class="setting-row">
                        <label id="lblTradLangsTitle">Filtro de Idiomas Entrantes</label>
                        <p class="modal-subtitle-extra-small" id="lblTradLangsDesc">Selecciona qué idiomas entrantes
                            quieres
                            traducir. Los desmarcados se mostrarán sin alterar.</p>
                        <div class="lang-selector-group" id="translateLangsContainer" style="margin-top: 12px;">
                            <% (typeof installedLangs !=='undefined' ? installedLangs : ['es', 'en' , 'eu'
                                ]).forEach(function(lang) { %>
                                <button class="lang-pill active" data-translate-lang="<%= lang %>">
                                    <%= lang.toUpperCase() %>
                                </button>
                                <% }); %>
                        </div>
                    </div>

                    <div class="setting-row">
                        <label id="lblTradDictTitle">Palabras Protegidas (Jerga Técnica)</label>
                        <p class="modal-subtitle-extra-small" id="lblTradDictDesc">Estas palabras NUNCA serán traducidas
                            por
                            la IA (Ej: Standby, Fader).</p>
                        <div class="dictionary-input-group-columns-modular" style="margin-top: 12px;">
                            <div class="dict-field" style="flex: 2;">
                                <input type="text" class="dict-input-mod" id="inputTradExclude"
                                    placeholder="Palabra a proteger..." maxlength="50">
                            </div>
                            <button class="btn-add-tag-mod" id="btnTradExcludeAdd" title="Añadir">+</button>
                        </div>
                        <div class="dictionary-tags-modular custom-scroll" id="translateExcludeTags">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sección Interfaz -->
            <div class="settings-section-content" id="section-interfaz">
                <h2 class="modal-title-small" id="lblSectionInterfazTitle">Personalización</h2>
                <div class="setting-row">
                    <label id="lblThemeMode">Modo Visual</label>
                    <div class="theme-switch-elegant">
                        <button class="theme-btn-mod active" data-theme="dark">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
