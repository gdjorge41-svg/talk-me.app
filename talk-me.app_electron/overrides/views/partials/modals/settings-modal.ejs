                </div>

                <button class="btn-add" id="addNewTriggerBtn">
                    <svg id="svgAddTrigger" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span id="lblAddTrigger">Añadir Trigger</span>
                </button>
            </div>

            <!-- Sección Guía de Usuario -->
