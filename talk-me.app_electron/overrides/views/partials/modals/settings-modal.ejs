                            <div class="talkme-slider-container">
                                <input type="range" id="hermesRateRange" min="0.5" max="2.0" step="0.1" value="1.0">
                                <span id="hermesRateValueLabel">1.0x</span>
                            </div>
                        </div>
                    </div>
                </div>
