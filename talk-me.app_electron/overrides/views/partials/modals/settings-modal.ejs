<!-- Modal Ajustes Generales Modular - Menu -->
<div class="user-modal hidden" id="settingsModal">
    <div class="modal-content settings-modular-content">
        <button class="modal-close-icon" id="btnCloseSettingsIcon" title="Cerrar">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2.5" fill="none"
                stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        <div class="settings-nav">
            <!-- [v46.4.66.9] Control de Sala Prioritario para el Master -->
            <button class="nav-item master-only-nav" data-section="section-control" id="navItemControl"
                style="display: none;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>Control Sala</span>
            </button>
            <button class="nav-item" data-section="section-audio">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 11V9a9 9 0 0 1 18 0v2" />
                    <rect x="2" y="11" width="4" height="6" rx="1" fill="currentColor" stroke="none" />
                    <rect x="18" y="11" width="4" height="6" rx="1" fill="currentColor" stroke="none" />
                    <path d="M20 17v1a2 2 0 0 1-2 2h-2" />
                </svg>
                <span id="lblNavAudio">Audio</span>
            </button>
            <button class="nav-item" data-section="section-idioma">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="7" cy="7" r="4" />
                    <path d="M15.54 5.46a5 5 0 0 1 0 7.07" />
                    <path d="M19.07 1.93a10 10 0 0 1 0 14.14" />
                </svg>
                <span id="lblNavIdioma">Idioma</span>
            </button>

            <button class="nav-item" data-section="section-traduccion">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 8l6 6"></path>
                    <path d="M4 14l6-6 2-3"></path>
                    <path d="M2 5h12"></path>
                    <path d="M7 2h1"></path>
                    <path d="M22 22l-5-10-5 10"></path>
                    <path d="M14 18h6"></path>
                </svg>
                <span id="lblNavTraduccion">Traducción</span>
            </button>

            <button class="nav-item" data-section="section-mensajes">
                <svg viewBox="0 0 24 24" width="20" height="20">
                    <path
                        d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"
                        fill="currentColor" />
                </svg>
                <span id="lblNavMensajes">Mensajes</span>
            </button>

            <button class="nav-item" data-section="section-alertas">
                <svg viewBox="0 0 24 24" width="20" height="20">
                    <path
                        d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                        fill="currentColor" />
                </svg>
                <span id="lblNavAlertas">Alertas</span>
            </button>

            <button class="nav-item" data-section="section-triggers">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
                <span id="lblNavTriggers">Triggers</span>
            </button>


            <button class="nav-item" data-section="section-interfaz">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                    <!-- Mango -->
                    <path d="M18 2a2.828 2.828 0 0 1 4 4L16 12l-4-4z" />
                    <!-- Virola -->
                    <path d="M11 9l4 4-1 1-4-4z" />
                    <!-- Cerda -->
                    <path d="M9 11c-4 2-6 6-7 11 5-1 9-3 11-7z" />
                </svg>
                <span id="lblNavInterfaz">Interfaz</span>
            </button>

            <button class="nav-item" data-section="section-guia">
                <svg viewBox="0 0 14 14" width="20" height="20" fill="currentColor" role="img" focusable="false"
                    aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
