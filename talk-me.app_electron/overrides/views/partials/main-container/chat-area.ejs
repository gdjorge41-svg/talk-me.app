<div class="chat-area">
    <!-- Header del Chat -->
    <div class="chat-header">
        <div class="header-status-group">
            <div class="server-connection-top" id="connectionStatus">
                <span id="connectionStatusIP">https://192.168.0.4:3000/</span>
                <div class="status-icon-container blink-green" id="connectionStatusDot">
                    <svg viewBox="0 0 24 24" class="status-icon-svg">
                        <circle cx="12" cy="12" r="8" fill="currentColor"></circle>
                    </svg>
                </div>
            </div>
            <div style="display: flex; align-items: center; position: relative; ">
                <button id="btnMuteGlobal" class="btn-mute-global" title="Mute/Unmute">
                    <svg viewBox="0 0 24 24" id="sound-max" class="icon flat-line icon-unmuted"
                        style="width: 22px; height: 22px; fill: currentColor; stroke: currentColor; transition: transform 0.2s;">
                        <path id="mute_speaker_bg" d="M11,5V19L7,15H4a1,1,0,0,1-1-1V10A1,1,0,0,1,4,9H7Z"
                            style="stroke: none;"></path>
                        <path id="mute_wave_outer" d="M18.36,5.64a9,9,0,0,1,0,12.72"
                            style="fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5;">
                        </path>
                        <path id="mute_wave_inner" d="M15.54,8.46a5,5,0,0,1,0,7.08"
                            style="fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5;">
                        </path>
                        <path id="mute_speaker_outline" d="M11,5V19L7,15H4a1,1,0,0,1-1-1V10A1,1,0,0,1,4,9H7Z"
                            style="fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5;">
                        </path>
                        <line id="mute_slash" x1="3" y1="3" x2="21" y2="21"
                            style="stroke: currentColor; stroke-width: 2.0; stroke-linecap: round; display: none;">
                        </line>
                    </svg>
                    <svg fill="currentColor" stroke="currentColor" viewBox="-1 0 21 19" xmlns="http://www.w3.org/2000/svg" class="icon icon-muted cf-icon-svg" style="display: none; width: 22px; height: 22px;">
                        <path d="M7.676 4.938v9.63c0 .61-.353.756-.784.325l-2.896-2.896H2.02A1.111 1.111 0 0 1 .911 10.89V8.618a1.112 1.112 0 0 1 1.108-1.109h1.977l2.896-2.896c.43-.43.784-.284.784.325z"></path>
                        <g transform="translate(1.8, 0)">
                            <path d="M14.927 11.826a.554.554 0 1 1-.784.784l-2.072-2.073-2.073 2.073a.554.554 0 1 1-.784-.784l2.073-2.073L9.214 7.68a.554.554 0 0 1 .784-.783L12.07 8.97l2.072-2.073a.554.554 0 0 1 .784.783l-2.072 2.073z"></path>
                        </g>
                    </svg>
                </button>
                <div class="status-indicator silent" id="statusIndicator">
                    <svg class="status-indicator-svg" viewBox="0 0 24 24">
                        <path class="mic-body" d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                        <line x1="12" y1="19" x2="12" y2="22" />
                    </svg>
                    <span id="statusIndicatorText">EN SILENCIO</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Barra de Filtros (Ahora estática para evitar saltos) -->
    <div class="category-filter-bar" id="categoryFilterBar" style="display: none;">
        <!-- Los botones se insertarán aquí dinámicamente -->
    </div>

    <!-- Indicador de Usuario Hablando (se unifica en el chat-status-area) -->
    <div class="user-speaking-indicator status-message info" id="userSpeakingIndicator" style="display: none;">
        🔊 <span id="speakingUser">Usuario</span> está hablando...
    </div>

    <!-- Contenedor de Mensajes -->
    <div class="messages-container">
        <div class="messages custom-scroll" id="messagesContainer">
            <!-- Mensajes aparecen aquí -->
        </div>
    </div>

    <!-- Área de Input Chat -->
    <div class="input-area">
        <button class="btn-attach" id="btnAttach" title="Enviar foto">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2.5" fill="none"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z">
                </path>
                <circle cx="12" cy="13" r="4"></circle>
            </svg>
        </button>
        <input type="file" id="fileInput" accept="image/*" capture="environment" style="display: none;">
        <div class="input-wave-container" id="inputWaveContainer">
            <input type="text" class="text-input" id="textInput" placeholder="Escribe tu mensaje...">
            <div class="voice-wave" id="voiceWave"></div>
        </div>
        <button class="btn-send" id="btnSend">
            <span id="btnSendText">Enviar</span>
            <svg id="btnSendIcon" class="btn-send-svg" viewBox="0 0 24 24" style="display: none;">
                <path class="mic-body" d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
                <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                <line x1="12" y1="19" x2="12" y2="22" />
            </svg>
            <!-- Icono Flecha de Envío (se muestra al escribir texto) -->
            <svg id="btnSendArrowIcon" class="btn-send-svg" viewBox="0 0 24 24"
                style="display: none; fill: white; stroke: none;">
                <path d="M2,21L23,12L2,3V10L17,12L2,14V21Z" />
            </svg>
        </button>
    </div>
</div>